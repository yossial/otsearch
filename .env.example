# ─── Database ─────────────────────────────────────────────────────
# Docker local: start with `docker compose up -d`
# Alternative: use MongoDB Atlas M0 free cluster URI
MONGODB_URI=

# ─── Auth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── AWS S3 ────────────────────────────────────────────────────────
# IAM user: ot-connect-app (created in AWS account 761103826610)
# Key ID is safe to note here; paste the secret key from the terminal output when we ran `aws iam create-access-key`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY="
S3_BUCKET_NAME=
S3_REGION=

# ─── Google Maps ───────────────────────────────────────────────────
# See setup steps below
GOOGLE_MAPS_API_KEY=

# ─── Email (Resend) ────────────────────────────────────────────────
# See setup steps below
RESEND_API_KEY=
EMAIL_FROM=noreply@therapio.com

# ─── Payments (PayPlus) ────────────────────────────────────────────
# See setup steps below
PAYPLUS_API_KEY=

# ─── AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Patient Data Encryption ───────────────────────────────────────
# AES-256-GCM field-level encryption key for sensitive patient data (diagnosis notes, session notes).
# Must be a 64-character lowercase hex string representing 32 random bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
# Field-level AES-256-GCM encryption key — 64 hex chars (32 bytes). Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
