# ─── Database ─────────────────────────────────────────────────────
# Local dev (Docker Compose): run `npm run db:up` then use the URI below
MONGODB_URI=mongodb://localhost:27017/otsearch
# Production / Vercel (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/otsearch?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# ─── AWS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APP_RUNNER_ROLE_ARN=

# ─── Storage ───────────────────────────────────────────────────────
S3_BUCKET_NAME=ot-connect-dev-uploads
S3_REGION=eu-west-1

# ─── Payments ──────────────────────────────────────────────────────
PAYPLUS_API_KEY=

# ─── Maps ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Email ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ot-connect.co.il

# ─── Patient Data Encryption ───────────────────────────────────────
# AES-256-GCM field-level encryption key for sensitive patient data (diagnosis notes, session notes).
# Must be a 64-character lowercase hex string representing 32 random bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=
# Field-level AES-256-GCM encryption key — 64 hex chars (32 bytes). Generate: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=
