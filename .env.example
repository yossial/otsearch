# ─── Database ─────────────────────────────────────────────────────
# Local dev (Docker Compose): run `npm run db:up` then use the URI below
MONGODB_URI=mongodb://localhost:27017/otsearch
# Production / Vercel (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/otsearch?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────
# NextAuth v5 uses AUTH_SECRET / AUTH_URL; NEXTAUTH_* variants are kept as aliases
AUTH_SECRET=<generate: openssl rand -base64 32>
AUTH_URL=http://localhost:3000
# Legacy aliases (still read by NextAuth v5)
NEXTAUTH_SECRET=<same value as AUTH_SECRET>
NEXTAUTH_URL=http://localhost:3000

# ─── Google OAuth ───────────────────────────────────────────────────
# 1. Create a Web Application OAuth 2.0 Client in Google Cloud Console
# 2. Add Authorized redirect URIs:
#    http://localhost:3000/api/auth/callback/google
#    https://<dev-app-runner-url>/api/auth/callback/google
#    https://<prod-app-runner-url>/api/auth/callback/google
# 3. Store in AWS Secrets Manager: ot-connect/dev/GOOGLE_CLIENT_ID etc.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── AWS ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APP_RUNNER_ROLE_ARN=

# ─── Storage ───────────────────────────────────────────────────────
S3_BUCKET_NAME=ot-connect-dev-uploads
S3_REGION=eu-west-1

# ─── Payments ──────────────────────────────────────────────────────
PAYPLUS_API_KEY=

# ─── Maps ──────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ─── Email ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@ot-connect.co.il

# ─── Admin bootstrap (one-time use — remove after first admin is created) ──────
# Generate: openssl rand -hex 32
# Leave unset to disable the endpoint entirely (returns 404)
ADMIN_BOOTSTRAP_TOKEN=

# ─── Feature flags (set to 'true' to enable) ────────────────────────
# Show therapist fee/price range on cards and profile pages (default: off)
NEXT_PUBLIC_SHOW_THERAPIST_FEE=false
# Show star rating on cards and profile pages (default: off)
NEXT_PUBLIC_SHOW_THERAPIST_RATING=false
